# --- API ---
FLASK_ENV=development
SECRET_KEY=change-me
API_PORT=5000

# --- Database ---
# Owner/DDL role. Used for `flask db upgrade`/`migrate` (host-side, or via
# `docker compose run -e DATABASE_URL=...`) -- NOT what the running app
# connects as day-to-day, see APP_DATABASE_URL below and
# docs/database-migrations.md. Port 5433 (not 5432) so this stack doesn't
# collide with another local Postgres.
DATABASE_URL=postgresql://creditguard:creditguard@localhost:5433/creditguard

# Restricted runtime role (CHECKLIST.md Phase 5 DB permission separation):
# full CRUD on ordinary tables, but only ever INSERT into audit tables, and
# no DDL rights at all. This is what docker-compose's api service actually
# connects as; APP_DB_PASSWORD must match what the
# a4e71d2b014c_add_restricted_runtime_db_role migration created the role
# with (it reads the same env var, defaulting to the same dev password if
# unset -- change one, change both).
APP_DB_PASSWORD=creditguard_app_dev_password
APP_DATABASE_URL=postgresql://creditguard_app:creditguard_app_dev_password@localhost:5433/creditguard

# --- Kafka ---
# Off by default -- the outbox table records every event regardless (see
# app/services/outbox_service.py), so nothing is lost while this is false.
KAFKA_ENABLED=false
# Port 9093 (not 9092) so this stack doesn't collide with another local Kafka
# broker. Inside docker-compose, the api service overrides this to `kafka:9092`.
KAFKA_BOOTSTRAP_SERVERS=localhost:9093

# --- Auth / Identity ---
JWT_SECRET_KEY=change-me

# OIDC (app/security/): Keycloak locally (docker-compose's keycloak
# service, realm imported from infra/keycloak/creditguard-realm.json),
# swappable for an enterprise IdP in production without code changes.
# These must be the *internal* Docker-network address, since that's what
# issues and must validate the tokens the api service actually receives
# -- not the host-side port (localhost:8081) used to reach the admin
# console. See docs/local-development.md.
OIDC_ISSUER=http://keycloak:8080/realms/creditguard
OIDC_JWKS_URL=http://keycloak:8080/realms/creditguard/protocol/openid-connect/certs
OIDC_AUDIENCE=creditguard-api

# --- Model / artefact store ---
MODEL_REGISTRY_URI=file://./model_artifacts
DATASET_STORE_URI=file://./data/processed

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:5000/api/v1
