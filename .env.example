# --- API ---
FLASK_ENV=development
SECRET_KEY=change-me
API_PORT=5000

# --- Database ---
# Host-side value (e.g. running `flask db migrate` outside Docker against the
# dockerized Postgres below). Inside docker-compose, the api service overrides
# this to the internal `postgres:5432` hostname/port — see docker-compose.yml.
# Port 5433 (not 5432) so this stack doesn't collide with another local Postgres.
DATABASE_URL=postgresql://creditguard:creditguard@localhost:5433/creditguard

# --- Kafka ---
# Port 9093 (not 9092) so this stack doesn't collide with another local Kafka
# broker. Inside docker-compose, the api service overrides this to `kafka:9092`.
KAFKA_BOOTSTRAP_SERVERS=localhost:9093
KAFKA_AUDIT_TOPIC=creditguard.audit.events
KAFKA_MONITORING_TOPIC=creditguard.monitoring.events

# --- Auth / Identity ---
JWT_SECRET_KEY=change-me
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Model / artefact store ---
MODEL_REGISTRY_URI=file://./model_artifacts
DATASET_STORE_URI=file://./data/processed

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:5000/api/v1
