# --- API ---
FLASK_ENV=development
SECRET_KEY=change-me
API_PORT=5000

# Structured JSON logging (app/observability/logging_config.py) --
# standard Python logging level names. GET /metrics (Prometheus format)
# and GET /api/v1/monitoring/observability (JSON summary, for the
# frontend Monitoring page) need no configuration -- always on.
LOG_LEVEL=INFO

# --- Database ---
# Owner/DDL role. Used for `flask db upgrade`/`migrate` (host-side, or via
# `docker compose run -e DATABASE_URL=...`) -- NOT what the running app
# connects as day-to-day, see APP_DATABASE_URL below and
# docs/database-migrations.md. Port 5433 (not 5432) so this stack doesn't
# collide with another local Postgres.
DATABASE_URL=postgresql://creditguard:creditguard@localhost:5433/creditguard

# tests/test_migrations.py downgrades its target database to base and
# back as part of what it verifies -- pointed at a genuinely separate
# Postgres *server* (docker-compose.yml's postgres-migrations-test
# service, port 5434, no persistent volume) instead of the main one
# above, so it no longer wipes tenants/users/decisions/etc. created by
# hand for manual/demo use. A second database on the *same* server isn't
# enough: Postgres roles are cluster-wide, so the restricted
# creditguard_app role would still fail to drop (grants still exist on
# the main database in the same cluster). Falls back to DATABASE_URL if
# unset -- see docs/local-development.md.
MIGRATION_TEST_DATABASE_URL=postgresql://creditguard:creditguard@localhost:5434/creditguard

# Restricted runtime role (CHECKLIST.md Phase 5 DB permission separation):
# full CRUD on ordinary tables, but only ever INSERT into audit tables, and
# no DDL rights at all. This is what docker-compose's api service actually
# connects as; APP_DB_PASSWORD must match what the
# a4e71d2b014c_add_restricted_runtime_db_role migration created the role
# with (it reads the same env var, defaulting to the same dev password if
# unset -- change one, change both).
APP_DB_PASSWORD=creditguard_app_dev_password
APP_DATABASE_URL=postgresql://creditguard_app:creditguard_app_dev_password@localhost:5433/creditguard

# --- Kafka ---
# Off by default -- the outbox table records every event regardless (see
# app/services/outbox_service.py), so nothing is lost while this is false.
KAFKA_ENABLED=false
# Port 9093 (not 9092) so this stack doesn't collide with another local Kafka
# broker. Inside docker-compose, the api service overrides this to `kafka:9092`.
KAFKA_BOOTSTRAP_SERVERS=localhost:9093

# --- Auth / Identity ---
JWT_SECRET_KEY=change-me

# OIDC (app/security/): Keycloak locally (docker-compose's keycloak
# service, realm imported from infra/keycloak/creditguard-realm.json),
# swappable for an enterprise IdP in production without code changes.
# OIDC_ISSUER is the host-side address on purpose: both a browser (the
# React app, which can only ever reach Keycloak via localhost) and this
# api container need to agree on the token's `iss` claim, and Keycloak
# is pinned (KC_HOSTNAME in docker-compose.yml) to present itself as
# localhost:8081 regardless of who's asking. docker-compose.yml
# overrides OIDC_JWKS_URL for the api service to a container-reachable
# address (the actual network hop for fetching signing keys can differ
# from the issuer string) -- see docs/local-development.md.
OIDC_ISSUER=http://localhost:8081/realms/creditguard
OIDC_JWKS_URL=http://localhost:8081/realms/creditguard/protocol/openid-connect/certs
OIDC_AUDIENCE=creditguard-api

# --- Model / artefact store ---
MODEL_REGISTRY_URI=file://./model_artifacts
DATASET_STORE_URI=file://./data/processed

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:5000/api/v1

# OIDC for the React app itself (apps/web/src/services/authConfig.ts):
# Authorization Code + PKCE against the `creditguard-web` client (public,
# no secret -- see infra/keycloak/creditguard-realm.json). Always the
# host-side address; a browser can never reach the `keycloak` Docker
# service name directly.
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/creditguard
VITE_OIDC_CLIENT_ID=creditguard-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/
