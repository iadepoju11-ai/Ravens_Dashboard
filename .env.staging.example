# --- Staging environment configuration (TEMPLATE) ---
# Copy this to .env.staging (gitignored by the .env.* rule in .gitignore;
# .env.staging.example is one of the two explicit exceptions, alongside
# .env.example itself) and replace every CHANGE_ME with a real, generated
# secret before running docker-compose.staging.yml. Never reuse the plain
# "creditguard"/"change-me" values from the dev .env.example -- those are
# intentionally public local-dev convenience values; staging secrets must
# not be. See docs/runbooks/deployment.md for the full deploy procedure.
#
# If staging runs somewhere other than the same machine you're reading
# this on, replace every "localhost" below with that host's real address
# -- these are read literally (Docker Compose does not expand ${VARS}
# inside an env_file's own contents, only inside the compose YAML), so
# there is no single place to change it.

# --- API ---
FLASK_ENV=production
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Structured JSON logging (app/observability/logging_config.py) -- every
# line to stdout is one JSON object, consumable by any log shipper
# without a custom parser. GET /metrics (Prometheus format) and
# GET /api/v1/monitoring/observability (JSON summary) need no
# configuration here -- always on, see docs/runbooks/deployment.md.
LOG_LEVEL=INFO

# --- Database ---
# Owner/DDL role -- used only by the one-shot `migrate` service
# (docker-compose.staging.yml) that runs before the api service starts.
DB_OWNER_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://creditguard:CHANGE_ME@postgres:5432/creditguard

# Restricted runtime role (docs/database-migrations.md's DB permission
# separation) -- what the api service actually connects as day to day.
# Must differ from DB_OWNER_PASSWORD; must match between these two lines.
APP_DB_PASSWORD=CHANGE_ME_different_from_DB_OWNER_PASSWORD
APP_DATABASE_URL=postgresql://creditguard_app:CHANGE_ME_different_from_DB_OWNER_PASSWORD@postgres:5432/creditguard

# --- Kafka ---
# Producers only in this pass -- no consumer exists yet (CHECKLIST.md), so
# leave this disabled unless something downstream is actually reading the
# topics. The outbox table records every event regardless of this flag.
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Keycloak ---
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# A browser and the api container reach Keycloak via different network
# paths, but a token's `iss` claim has to match what both sides expect --
# same reasoning as the dev docker-compose.yml's KC_HOSTNAME/OIDC_ISSUER
# split, just on staging's own ports (8181 instead of 8081, so the two
# stacks can run side by side without colliding).
OIDC_ISSUER=http://localhost:8181/realms/creditguard
OIDC_JWKS_URL=http://keycloak:8080/realms/creditguard/protocol/openid-connect/certs
OIDC_AUDIENCE=creditguard-api

# --- Frontend ---
# Baked into the static bundle at image *build* time (apps/web/Dockerfile
# build args) -- there is no runtime env-var injection for a static file
# server, so changing these means rebuilding the web image, not just
# restarting the container.
VITE_API_BASE_URL=http://localhost:5100/api/v1
VITE_OIDC_AUTHORITY=http://localhost:8181/realms/creditguard
VITE_OIDC_CLIENT_ID=creditguard-web
VITE_OIDC_REDIRECT_URI=http://localhost:8090/
